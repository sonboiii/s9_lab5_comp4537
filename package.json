{
  "name": "server2",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "server1": "node server1/server.js",
    "server2": "node --env-file=.env server2/server.js",
    "server_2": "node --env-file=.env server2/server_2.js",
    "local": "concurrently --kill-others --names server1,server2 \"node server1/server.js\" \"node --env-file-if-exists=.env server2/server_2.js\"",
    "remote": "concurrently --kill-others --names server1,server2 \"node server1/server.js\" \"node --env-file=.env server2/server_2.js --remote\""
  },
